# Where Claude Code keeps session transcripts (default ~/.claude/projects).
CLAUDE_PROJECTS_DIR=
# Codex CLI home; history.jsonl and sessions/ are read if present (default ~/.codex).
CODEX_HOME=
# Ledger + snapshot folder (default ./state).
BUG_SWEEPER_STATE_DIR=
# Override the ledger file itself (default $BUG_SWEEPER_STATE_DIR/bug-sweeper.ledger.json).
LEDGER_FILE=
# Receipt folder written by bin/run.sh (default ./receipts).
BUG_SWEEPER_RECEIPTS=
# Claude Code executable used by bin/run.sh (default claude).
CLAUDE_BIN=
